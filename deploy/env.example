# The settings of the production stack (deploy/docker-compose.prod.yml).
#
#   cp deploy/env.example deploy/.env
#
# The two secrets below are empty on purpose: Compose refuses to start until you fill both in, so a copy that was not edited
# cannot run with a value that everybody who reads this file knows. The two names that say CHANGE_ME are examples to replace.
# `deploy/.env` is ignored by git and holds real secrets: never commit it, never paste it into an issue, a chat or an image.

# --- Public address ------------------------------------------------------------------------------------------------

# The host name people type, without a scheme or a port. Caddy obtains a certificate for it, so its DNS record has to
# point at this machine and ports 80 and 443 have to be reachable. A name such as draftroom.localhost makes Caddy issue
# a certificate from its own authority instead, for trying the stack on one machine.
SITE_ADDRESS=CHANGE_ME.example.org

# The origin of the app as the browser sees it: the scheme, the host and, only when it is not 443, the port. It is the
# value the server accepts as an origin (ALLOWED_ORIGINS), so a mismatch shows as refused requests.
PUBLIC_ORIGIN=https://CHANGE_ME.example.org

# The ports the proxy publishes on this machine. Change them only to run the stack next to another one, and then put
# the port in PUBLIC_ORIGIN too.
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Secrets -------------------------------------------------------------------------------------------------------

# Signs and checks sessions: at least 32 characters, different in every environment, never reused. Changing it signs
# everybody out. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# The password of the database user. It goes inside a connection URL, so use only letters and digits (the output of
# `openssl rand -hex 24` is fine). It is read once, when the volume is first created: to change it later, change it in
# PostgreSQL too (ALTER USER), then here.
POSTGRES_PASSWORD=

# --- Database ------------------------------------------------------------------------------------------------------

# The database role and database created on the first start. The defaults are fine unless several stacks share a host.
# POSTGRES_USER=draftroom
# POSTGRES_DB=draftroom

# --- Release -------------------------------------------------------------------------------------------------------

# The tag of the images this Compose file builds, so a deployment can say which version it runs.
# DRAFTROOM_VERSION=local
