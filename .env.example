# Copy to `.env` for local development. `.env` is ignored by git; never commit real values.

# --- The server (apps/server) ---
NODE_ENV=development
API_PORT=8380
COLLAB_PORT=8480
DATABASE_URL=postgres://draftroom:draftroom@127.0.0.1:5460/draftroom
# Required when NODE_ENV=production, at least 32 characters (for example `openssl rand -hex 32`).
# In development keep this fixed: the CSRF tokens are made with it, and a server that restarts with another (`npm run dev`
# restarts on every save) keeps your session but refuses every change and signing out, until you sign in again.
# This value is for development only and protects nothing.
SESSION_SECRET=development-only-session-secret-0123456789
# Comma-separated origins allowed to open the collaboration connection, such as https://draftroom.example.
# Required when NODE_ENV=production.
ALLOWED_ORIGINS=

# --- docker-compose.yml (development credentials) ---
POSTGRES_PORT=5460
POSTGRES_USER=draftroom
POSTGRES_PASSWORD=draftroom
POSTGRES_DB=draftroom
