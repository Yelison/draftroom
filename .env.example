# Copy to `.env` for local development. `.env` is ignored by git; never commit real values.

# --- The server (apps/server) ---
NODE_ENV=development
API_PORT=8380
COLLAB_PORT=8480
DATABASE_URL=postgres://draftroom:draftroom@127.0.0.1:5460/draftroom
# Required when NODE_ENV=production, at least 32 characters (for example `openssl rand -hex 32`).
# In development keep this fixed: the CSRF tokens are made with it, and a server that restarts with another (`npm run dev`
# restarts on every save) keeps your session but refuses every change and signing out, until you sign in again.
# This value is for development only and protects nothing.
SESSION_SECRET=development-only-session-secret-0123456789
# Comma-separated origins of the app, such as https://draftroom.example. They are the only ones whose pages may read the API
# with their cookies (CORS) and the only ones that may open the collaboration connection. There is no wildcard.
# Required when NODE_ENV=production.
ALLOWED_ORIGINS=
# The proxies in front of the server, by address or range (10.0.0.0/8, 172.18.0.0/16) or loopback, linklocal, uniquelocal.
# Only a request that comes from one of them is believed when it says X-Forwarded-For, which is how the limits on requests and
# on sign-in see the address of the person and not the proxy's. Leave it empty when nothing is in front of the server: with it
# set, anybody could choose their own address. `true` and a number of proxies are refused.
TRUST_PROXY=

# --- docker-compose.yml (development credentials) ---
POSTGRES_PORT=5460
POSTGRES_USER=draftroom
POSTGRES_PASSWORD=draftroom
POSTGRES_DB=draftroom
