{
  "name": "@draftroom/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node --env-file-if-exists=../../.env src/db/run-migrations.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@draftroom/contract": "*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "testcontainers": "12.2.1"
  }
}
