{
  "name": "@draftroom/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node src/main.ts",
    "migrate": "node --env-file-if-exists=../../.env src/db/run-migrations.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed:demo": "node --env-file-if-exists=../../.env src/db/demo-seed/run.ts",
    "measure:position-migrations": "node scripts/measure-position-migrations.ts"
  },
  "dependencies": {
    "@draftroom/contract": "*",
    "@draftroom/editor-schema": "*",
    "@hocuspocus/server": "4.7.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "4.7.1",
    "@testcontainers/postgresql": "12.2.1",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-collaboration": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "jsdom": "30.1.2",
    "testcontainers": "12.2.1",
    "ws": "8.22.0"
  }
}
