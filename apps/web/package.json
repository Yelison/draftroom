{
  "name": "@draftroom/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pseudo": "vite build --mode pseudo",
    "build:demo": "VITE_DATA_SOURCE=mock vite build --mode production --base /draftroom/ --outDir dist-demo --emptyOutDir && cp dist-demo/index.html dist-demo/404.html",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e-demo": "playwright test -c e2e-demo/playwright.config.ts",
    "test:e2e-collab": "playwright test -c playwright.collab.config.ts",
    "test:contract-real": "vitest run --config e2e-collab/contract/vitest.config.ts",
    "sync:forma-tokens": "node scripts/sync-forma-tokens.mjs"
  },
  "dependencies": {
    "@draftroom/contract": "*",
    "@draftroom/editor-schema": "*",
    "@hocuspocus/provider": "4.8.0",
    "@tanstack/react-query": "5.105.0",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-collaboration": "3.32.2",
    "@tiptap/extension-collaboration-caret": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/y-tiptap": "3.0.12",
    "@yelison/forma-ui": "0.7.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-intl": "12.1.6",
    "react-router": "8.5.1",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@formatjs/cli": "6.16.36",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fake-indexeddb": "6.2.7",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "yaml": "2.9.1"
  }
