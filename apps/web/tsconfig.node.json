{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "outDir": null,
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // The build tooling and its tests, the browser specs, plus the few modules of `src` that the Vite configuration reads and the fixtures that the bundle guard searches for.
  "include": [
    "vite.config.ts",
    "scripts",
    "e2e",
    "src/i18n/locale.ts",
    "src/i18n/localeScript.ts",
    "src/i18n/*.json",
    "src/theme.ts",
    "src/data/mock/fixtures",
    "src/data/mock/ids.ts"
  ]
}
