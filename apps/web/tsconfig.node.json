{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "outDir": null,
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // The build tooling and its tests, the browser specs, plus the few modules of `src` that the Vite configuration reads the fixtures that the bundle guard searches for and the clipboard HTML the editor spec pastes.
  "include": [
    "vite.config.ts",
    "scripts",
    "e2e",
    "src/i18n/locale.ts",
    "src/i18n/localeScript.ts",
    "src/i18n/*.json",
    "src/theme.ts",
    "src/data/mock/fixtures",
    "src/data/mock/ids.ts",
    "src/features/editor/testing/wordProcessorHtml.ts"
  ],
  // The fixtures import types from the contract, so a change of `schema.ts` has to rebuild this project too.
  "references": [{ "path": "../../packages/contract" }]
}
