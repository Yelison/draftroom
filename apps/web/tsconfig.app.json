{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["vite/client", "@testing-library/jest-dom/vitest"],
    // The web app is bundled by Vite, so there is nothing to emit; the build info stays out of `dist/`.
    "noEmit": true,
    "emitDeclarationOnly": false,
    "outDir": null,
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  // The contract's types are an input of this project: when `schema.ts` changes, `tsc -b` must rebuild it.
  "references": [{ "path": "../../packages/contract" }]
}
